{
  "manifest_version": 1,
  "id": "woo-fit-recommender",
  "name": "Size & Fit Recommender",
  "description": "Three-question fit quiz that recommends a size and remembers the answer so future product pages are one tap.",
  "version": "0.1.0",
  "entry": "index.html",
  "isolation": "iframe",
  "display": {
    "modes": [
      "block",
      "page"
    ],
    "default": "block"
  },
  "permissions": {
    "read": [
      "commerce"
    ],
    "write": []
  },
  "commerce": {
    "providers": [
      "woocommerce"
    ],
    "endpoints": [
      "products"
    ]
  },
  "runtime": {
    "sandbox": "strict",
    "external_origins": []
  },
  "bundleDefaults": {}
}
